<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
  version="4.0">

  <servlet>
    <servlet-name>MovieListServlet</servlet-name>
    <servlet-class>xtflix.MovieListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>MovieListServlet</servlet-name>
    <url-pattern>/api/movies</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>SingleMovieServlet</servlet-name>
    <servlet-class>xtflix.SingleMovieServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SingleMovieServlet</servlet-name>
    <url-pattern>/api/single-movie</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>SingleStarServlet</servlet-name>
    <servlet-class>xtflix.SingleStarServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SingleStarServlet</servlet-name>
    <url-pattern>/api/single-star</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>xtflix.LoginServlet</servlet-class>w
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/api/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>SearchServlet</servlet-name>
    <servlet-class>xtflix.SearchServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SearchServlet</servlet-name>
    <url-pattern>/api/search</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>GenreListServlet</servlet-name>
    <servlet-class>xtflix.GenreListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>GenreListServlet</servlet-name>
    <url-pattern>/api/genres</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CartServlet</servlet-name>
    <servlet-class>xtflix.CartServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CartServlet</servlet-name>
    <url-pattern>/api/cart</url-pattern>
  </servlet-mapping>
</web-app>